programa
{
	
	funcao inicio()
	{
		inteiro idade 
		escreva("Informe idade: ")
		leia(idade)

		se(idade <= 12){
			escreva("A pessoa é uma criança!")
		}
		se(idade >= 13 e idade <= 17){
			escreva("A pessoa é um chatoleceste!")
		}
		se(idade >= 18 e idade <= 65){
			escreva("A pessoa é um adulto!")
		}
		se(idade > 65){
			escreva("A pessoa é um idoso!")
		}
	}
}
