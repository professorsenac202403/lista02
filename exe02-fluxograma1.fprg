    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idade1" type="Integer" array="False" size=""/>
            <declare name="idade2" type="Integer" array="False" size=""/>
            <if expression="idade1 &gt; idade2">
                <then>
                    <output expression="&quot;Mais velho &quot; &amp; idade1" newline="True"/>
                </then>
                <else>
                    <if expression="idade1 &lt; idade2">
                        <then>
                            <output expression="&quot;Mais velho &quot; &amp; idade2" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Idade igual&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
