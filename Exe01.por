programa
{
	
	funcao inicio()
	{
		real velocidade 
		escreva("Informe velocidade: ")
		leia(velocidade)

		se(velocidade > 80){
			escreva("Você vai levar uma multa rapá!")
		}senao{
			escreva("Estava na velocidade certa!")
		}
		
	}
}
